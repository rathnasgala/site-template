<!doctype html>
<html lang="{{ post.language or language or site.site.defaultLanguage }}" dir="{{ (post.language or language or site.site.defaultLanguage) | languageDirection }}" data-theme="{{ site.design.theme | default('modern') }}" data-layout="{{ site.design.layout | default('article-first') }}" data-palette="{{ site.design.palette | default('default') }}" data-mode="{{ site.design.colorMode | default('system') }}">
  {% set indexPage = articleIndex or (rootArticleIndex if not post and page.url == '/') %}
  {% set currentLanguage = post.language or language %}
  {% set ui = (currentLanguage or site.site.defaultLanguage) | uiLabels %}
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-{{ themeBootstrap | sha256Csp }}'{% if prismBootstrap %} 'sha256-{{ prismBootstrap | sha256Csp }}'{% endif %}{% if seo %} 'sha256-{{ seo.structuredDataJson | sha256Csp }}'{% endif %}; style-src 'self'; img-src 'self' data: https:; connect-src 'self' {{ site.platform.apiBaseUrl or 'https://api.gala67.com' }}{% if versionPage %} https://registry.npmjs.org https://app.gala67.com{% endif %}; frame-src {{ site.platform.apiBaseUrl or 'https://api.gala67.com' }} https://www.youtube-nocookie.com https://codepen.io; form-action 'self'; upgrade-insecure-requests">
    <script>{{ themeBootstrap | safe }}</script>
    {% if prismBootstrap %}<script>{{ prismBootstrap | safe }}</script>{% endif %}
    <title>{{ post.frontmatter.title or title }} · {{ site.site.name }}</title>
    {% if post %}<link rel="canonical" href="{{ post.canonicalUrl }}">{% elif indexPage %}<link rel="canonical" href="{{ indexPage.canonicalUrl }}">{% endif %}
    {% if indexPage.previousUrl %}<link rel="prev" href="{{ indexPage.previousUrl | publicationUrl(page.url) }}">{% endif %}
    {% if indexPage.nextUrl %}<link rel="next" href="{{ indexPage.nextUrl | publicationUrl(page.url) }}">{% endif %}
    {% for alternate in hreflangLinks %}<link rel="alternate" hreflang="{{ alternate.hreflang }}" href="{{ alternate.href }}">{% endfor %}
    {% for feed in feedLinks %}<link rel="alternate" type="application/atom+xml" hreflang="{{ feed.language }}" title="{{ feed.title }}" href="{{ feed.href }}">{% endfor %}
    {% if seo %}
    <meta name="description" content="{{ seo.description }}">
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ seo.title }}">
    <meta property="og:description" content="{{ seo.description }}">
    <meta property="og:url" content="{{ seo.canonicalUrl }}">
    {% if seo.imageUrl %}<meta property="og:image" content="{{ seo.imageUrl }}">{% endif %}
    <meta name="twitter:card" content="{{ seo.twitterCard }}">
    <meta name="twitter:title" content="{{ seo.title }}">
    <meta name="twitter:description" content="{{ seo.description }}">
    {% if seo.imageUrl %}<meta name="twitter:image" content="{{ seo.imageUrl }}">{% endif %}
    <script type="application/ld+json">{{ seo.structuredDataJson | safe }}</script>
    {% endif %}
    {% if post.publicationState == "tombstoned" %}<meta name="robots" content="noindex">{% endif %}
    <link rel="stylesheet" href="{{ '/assets/theme.css' | publicationUrl(page.url) }}">
    <link rel="stylesheet" href="{{ '/assets/accent.css' | publicationUrl(page.url) }}">
    <link rel="stylesheet" href="{{ '/custom.css' | publicationUrl(page.url) }}">
    <link rel="icon" href="{{ '/assets/favicon.svg' | publicationUrl(page.url) }}" type="image/svg+xml">
    <script src="{{ '/assets/reader.js' | publicationUrl(page.url) }}" defer></script>
    {% if versionPage %}<script src="{{ '/assets/version.js' | publicationUrl(page.url) }}" defer></script>{% endif %}
  </head>
  <body{% if post %} class="gala-page--article"{% endif %}>
    <a class="gala-skip-link" href="#main-content">Skip to content</a>
    <header class="gala-site-header">
      <a class="gala-site-name" href="{{ '/' | publicationUrl(page.url) }}" aria-label="Home">{{ site.site.name }}</a>
      <nav class="gala-site-header__actions" aria-label="Site controls">
        {% if post %}<a class="gala-header-link" href="#article">Article</a><a class="gala-header-link" href="#conversation">Conversation</a>{% endif %}
        {% if site.contact.enabled %}<a class="gala-icon-control" href="{{ '/contact/' | publicationUrl(page.url) }}" aria-label="Contact author" title="Contact">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.4" width="18" height="13.2" rx="2.2"/><path d="m3.9 7.3 7.2 5.1a1.6 1.6 0 0 0 1.8 0l7.2-5.1"/></svg>
        </a>{% endif %}
        <button class="gala-icon-control" type="button" data-theme-mode-toggle aria-label="Color mode: system. Activate for light." title="Appearance">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.1 13.6A8.2 8.2 0 1 1 10.4 3.9a6.4 6.4 0 0 0 9.7 9.7Z"/></svg>
          <span class="gala-visually-hidden" data-theme-mode-label>Theme: system</span>
        </button>
        <button class="gala-icon-control" type="button" data-open-dialog="gala-settings-dialog" aria-label="Settings" title="Settings">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2.9"/><path d="M19.3 14.6a1.5 1.5 0 0 0 .3 1.7l.1.1a1.8 1.8 0 1 1-2.6 2.6l-.1-.1a1.5 1.5 0 0 0-2.5 1.1v.3a1.8 1.8 0 0 1-3.6 0v-.2a1.5 1.5 0 0 0-2.6-1.1l-.1.1a1.8 1.8 0 1 1-2.6-2.6l.1-.1a1.5 1.5 0 0 0-1.1-2.5h-.3a1.8 1.8 0 0 1 0-3.6h.2a1.5 1.5 0 0 0 1.1-2.6l-.1-.1a1.8 1.8 0 1 1 2.6-2.6l.1.1a1.5 1.5 0 0 0 1.7.3h.1a1.5 1.5 0 0 0 .9-1.4v-.3a1.8 1.8 0 0 1 3.6 0v.2a1.5 1.5 0 0 0 2.5 1.1l.1-.1a1.8 1.8 0 1 1 2.6 2.6l-.1.1a1.5 1.5 0 0 0-.3 1.7v.1a1.5 1.5 0 0 0 1.4.9h.3a1.8 1.8 0 0 1 0 3.6h-.2a1.5 1.5 0 0 0-1.4.9Z"/></svg>
        </button>
        <button class="gala-icon-control" type="button" data-open-dialog="gala-search-dialog" aria-label="Search" title="Search">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20.3 20.3-4.4-4.4"/></svg>
        </button>
        <button class="gala-account-control" type="button" data-open-dialog="gala-account-dialog" data-user-control aria-label="Sign in or view account" title="Account">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 20.4v-1.7a3.9 3.9 0 0 0-3.9-3.9H8.9A3.9 3.9 0 0 0 5 18.7v1.7"/><circle cx="12" cy="7.6" r="3.9"/></svg>
          <span data-user-label>Sign in</span>
        </button>
      </nav>
    </header>
    <main id="main-content">{{ content | safe }}</main>
    <footer class="gala-page-footer">
      <section class="gala-page-footer__identity" aria-label="Publication author">
        {% if site.site.authorProfile.avatarUrl %}<img src="{{ site.site.authorProfile.avatarUrl | escape }}" alt="" width="40" height="40">{% endif %}
        <div class="gala-page-footer__details">
          <p class="gala-page-footer__line">
            {% if site.site.authorProfile.profileUrl %}<a class="gala-page-footer__author" href="{{ site.site.authorProfile.profileUrl | escape }}" rel="author">{{ site.site.authorProfile.displayName }}</a>{% else %}<strong class="gala-page-footer__author">{{ site.site.authorProfile.displayName }}</strong>{% endif %}
            {% if site.site.publisher.name %}<span>Published by {% if site.site.publisher.url %}<a href="{{ site.site.publisher.url | escape }}" rel="publisher">{{ site.site.publisher.name }}</a>{% else %}{{ site.site.publisher.name }}{% endif %}</span>{% endif %}
            <span>&copy; {{ site.site.name }}</span>
            {% if buildIdentity %}<span><a href="{{ buildIdentity.versionUrl | publicationUrl(page.url) }}" rel="external" aria-label="Publication build {{ buildIdentity.commit }}">{{ buildIdentity.shortCommit }}</a></span>{% endif %}
          </p>
          {% if site.site.authorProfile.bio %}<p class="gala-page-footer__bio">{{ site.site.authorProfile.bio }}</p>{% endif %}
        </div>
      </section>
      {# Which repository sent the traffic, which footer the click came from, which language it
         was read in, and which author owns it. Sites registered before these managed values
         existed fall back rather than emitting the literal placeholder. #}
      {% set galaLinkPlacement = 'article-footer' if post else 'site-footer' %}
      {% set galaLinkLanguage = post.language or site.site.defaultLanguage %}
      {% set galaLinkSource = site.site.repository if site.site.repository and site.site.repository != 'unavailable' else 'gala-site' %}
      {% set galaLinkOwner = site.site.ownerId if site.site.ownerId and site.site.ownerId != 'unavailable' else site.site.id %}
      <nav aria-label="Publication footer"><ul>
        {% if attributionTier != 'PAID' %}<li><a href="https://gala67.com/?utm_source={{ galaLinkSource | urlencode }}&amp;utm_medium=referral&amp;utm_campaign=powered-by-gala&amp;utm_content={{ galaLinkPlacement | urlencode }}&amp;utm_term={{ galaLinkLanguage | urlencode }}&amp;utm_id={{ galaLinkOwner | urlencode }}" rel="external">Powered by Gala</a></li>{% endif %}
        <li><a href="https://app.gala67.com/s/terms" rel="external">Terms</a></li>
        <li><a href="https://app.gala67.com/s/privacy" rel="external">Privacy</a></li>
      </ul></nav>
    </footer>
    <dialog id="gala-settings-dialog" class="gala-dialog" aria-labelledby="gala-settings-title">
      <header class="gala-dialog__header"><h2 id="gala-settings-title">{{ ui.readerSettings }}</h2><form method="dialog" class="gala-dialog__close"><button type="submit" aria-label="{{ ui.closeSettings }}">{{ ui.close }}</button></form></header>
      <label>{{ ui.preferredLanguage }}
        <select data-language-preference data-navigate-on-selection data-current-language="{{ (currentLanguage or '') | escape }}"><option value="" data-url="{{ '/' | publicationUrl(page.url) }}"{% if not currentLanguage %} selected{% endif %}>{{ ui.allLanguages }}</option>{% for availableLanguage in languages %}<option value="{{ availableLanguage | escape }}" data-url="{{ availableLanguage | languageDestination(page.url, hreflangLinks) }}"{% if availableLanguage == currentLanguage %} selected{% endif %}>{{ availableLanguage | languageName }}</option>{% endfor %}</select>
      </label>
    </dialog>
    <dialog id="gala-search-dialog" class="gala-dialog" aria-labelledby="gala-search-title">
      <header class="gala-dialog__header"><h2 id="gala-search-title">Search</h2><form method="dialog" class="gala-dialog__close"><button type="submit" aria-label="Close search">Close</button></form></header>
      <section data-gala-search data-index-url="{{ '/search-index.json' | publicationUrl(page.url) }}">
        <form class="gala-search" action="{{ '/search/' | publicationUrl(page.url) }}" role="search">
          <label for="gala-dialog-search-query">Search published posts</label>
          <input id="gala-dialog-search-query" name="q" type="search" autocomplete="off">
          <button type="submit">Search</button>
        </form>
        <p data-search-status role="status" aria-live="polite">Enter a search term.</p>
        <ol class="gala-search-results" data-search-results></ol>
      </section>
    </dialog>
    {% if site.site.id and site.site.id != "unavailable" %}
    <dialog id="gala-account-dialog" class="gala-dialog gala-account-dialog" aria-labelledby="gala-account-title">
      <form method="dialog" class="gala-dialog__close"><button type="submit" aria-label="Close account">Close</button></form>
      <h2 id="gala-account-title" class="gala-visually-hidden">Gala account</h2>
      <iframe data-gala-session-frame title="Gala account and sign in" loading="eager" allow="identity-credentials-get" src="{{ site.platform.apiBaseUrl or 'https://api.gala67.com' }}/v1/widget/session?siteId={{ site.site.id | escape }}"></iframe>
    </dialog>
    {% endif %}
  </body>
</html>
