---
layout: layouts/base.njk
---
{% from "components/ui.njk" import cardIndex, pagination %}
{% set ui = (articleIndex.language or site.site.defaultLanguage) | uiLabels %}
<h1>{% if articleIndex.language %}{{ ui.languageIndexTitle }}{% else %}{{ site.site.name }}{% endif %}</h1>
{{ cardIndex(articleIndex.cards, buildManifest.preview, page.url, ui) }}
{{ pagination(articleIndex.previousUrl, articleIndex.nextUrl, articleIndex.pageNumber, articleIndex.totalPages, page.url, ui) }}
