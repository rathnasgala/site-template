---
layout: layouts/base.njk
---
{% from "components/ui.njk" import actionRail, articleStats, conversation, languageSwitcher, tableOfContents %}
{% set ui = post.language | uiLabels %}
<article id="article" class="gala-article">
  {% if post.publicationState == "published" or (buildManifest.preview and post.publicationState == "not-emitted") %}<progress class="gala-reading-progress" data-reading-progress max="1" value="0" aria-label="Reading progress"></progress><header class="gala-article-header"><p class="gala-eyebrow">{% if post.publicationState == "published" %}Published{% else %}Scheduled for{% endif %} {{ post.frontmatter.publishAfterDate }} - {{ post.language }} - {{ readingMinutes }} min read</p><h1>{{ post.frontmatter.title }}</h1>{% set byline = post.frontmatter.author or site.site.author %}{% if post.contributorCredits.authors.length %}<p class="gala-byline">By {{ post.contributorCredits.authors | join(', ') }}{% if post.contributorCredits.editors.length %} · Edited by {{ post.contributorCredits.editors | join(', ') }}{% endif %}</p>{% elif byline and byline != "unavailable" and byline != "New Gala Site" and byline != site.site.name %}<p class="gala-byline">By {{ byline }}</p>{% endif %}</header>{% endif %}
  {% if post.publicationState == "published" %}{{ languageSwitcher(hreflangLinks, post.language, ui) }}{% endif %}
  {% if post.publicationState == "published" %}<p class="gala-article-provenance"><a href="{{ postMarkdownUrl }}" type="text/markdown">Markdown</a> · <a href="{{ postProvenanceUrl }}" rel="describedby">Provenance</a></p>{% endif %}
  {% if prismConfigurations.length %}<nav class="gala-prism-selector" aria-label="Approved editions">
    <span aria-current="page">Complete</span>
    {% for configuration in prismConfigurations %}<a href="{{ configuration.pageUrl }}" data-prism-select data-prism-article-id="{{ post.id }}" data-prism-language="{{ post.language }}" data-prism-configuration-id="{{ configuration.configurationId }}" data-prism-source-hash="{{ configuration.sourceRevisionHash }}"{% if post.prismConfigurationLinkPolicy == "NOFOLLOW" %} rel="nofollow"{% endif %}>{{ configuration.depth }} · {{ configuration.intent }}</a>{% endfor %}
  </nav>{% endif %}
  {% if post.publicationState == "published" %}<section class="gala-engagement" data-article-id="{{ post.id | escape }}" data-engagement-url="{{ site.platform.apiBaseUrl or 'https://api.gala67.com' }}/v1/articles/{{ post.id | escape }}/engagement">{% endif %}
    <div class="gala-reading-layout">
      {% if postTableOfContents.length %}{{ tableOfContents(postTableOfContents) }}{% else %}<span></span>{% endif %}
      <div class="gala-markdown">{{ content | safe }}</div>
      {% if post.frontmatter.sources %}<section class="gala-article-sources" aria-labelledby="gala-article-sources-title"><h2 id="gala-article-sources-title">Sources</h2><ol>{% for source in post.frontmatter.sources %}<li><a href="{{ source | escape }}" rel="external noreferrer">{{ source | escape }}</a></li>{% endfor %}</ol></section>{% endif %}
      {% if post.frontmatter.faq %}<section class="gala-article-faq" aria-labelledby="gala-article-faq-title"><h2 id="gala-article-faq-title">Frequently asked questions</h2>{% for item in post.frontmatter.faq %}<section><h3>{{ item.question | escape }}</h3><p>{{ item.answer | escape }}</p></section>{% endfor %}</section>{% endif %}
      {% if post.publicationState == "published" %}<div class="gala-article-boundary"><strong>Conversation</strong>{{ articleStats(engagement) }}</div><span class="gala-action-dock" data-action-dock aria-hidden="true"></span>{{ actionRail(post.canonicalUrl) }}{% endif %}
    </div>
    {% if post.publicationState == "published" %}{{ conversation(engagement) }}{% endif %}
  {% if post.publicationState == "published" %}</section>{% endif %}
</article>
